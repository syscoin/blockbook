{
  "coin": {
    "name": "Syscoin Testnet",
    "shortcut": "tSYS",
    "label": "Syscoin Testnet",
    "alias": "syscoin_testnet"
  },
  "ports": {
    "backend_rpc": 18067,
    "backend_message_queue": 48367,
    "blockbook_internal": 19067,
    "blockbook_public": 19167
  },
  "ipc": {
    "rpc_url_template": "http://127.0.0.1:{{.Ports.BackendRPC}}",
    "rpc_user": "rpc",
    "rpc_pass": "rpc",
    "rpc_timeout": 25,
    "message_queue_binding_template": "tcp://127.0.0.1:{{.Ports.BackendMessageQueue}}"
  },
  "backend": {
    "package_name": "backend-syscoin-testnet",
    "package_revision": "satoshilabs-1",
    "system_user": "syscoin",
    "version": "5.1.3.0",
    "binary_url": "https://github.com/syscoin/syscoin/releases/download/v5.1.3/syscoin-5.1.3-x86_64-linux-gnu.tar.gz",
    "_verification_type": "gpg-sha256",
    "_verification_source": "https://github.com/syscoin/syscoin/releases/download/v5.1.3/SHA256SUMS.asc",
    "verification_type": "sha256",
    "verification_source": "336ebb62f9079b1949eb669d87ea61db3d49a7f548378a539a1454302ce98313",
    "extract_command": "tar -C backend --strip 1 -xf",
    "exclude_files": [
      "bin/syscoin-qt"
    ],
    "exec_command_template": "{{.Env.BackendInstallPath}}/{{.Coin.Alias}}/bin/syscoind -datadir={{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend -conf={{.Env.BackendInstallPath}}/{{.Coin.Alias}}/{{.Coin.Alias}}.conf -pid=/run/{{.Coin.Alias}}/{{.Coin.Alias}}.pid",
    "logrotate_files_template": "{{.Env.BackendDataPath}}/{{.Coin.Alias}}/backend/testnet3/*.log",
    "postinst_script_template": "",
    "service_type": "forking",
    "service_additional_params_template": "",
    "protect_memory": true,
    "mainnet": false,
    "server_config_file": "syscoin.conf",
    "client_config_file": "bitcoin_client.conf",
    "additional_params": {
      "deprecatedrpc": "estimatefee",
      "gethcommandline": [
        "--http",
        "--http.addr",
        "127.0.0.1",
        "--http.port",
        "18545",
        "--http.api",
        "eth,net,web3",
        "--port",
        "30304"
      ]
    },
    "platforms": {
      "arm64": {
        "binary_url": "https://github.com/syscoin/syscoin/releases/download/v5.1.3/syscoin-5.1.3-aarch64-linux-gnu.tar.gz",
        "verification_source": "571ebd6dc5dc335253bb159df2fd6e12940a9d49d7f9ac3cf9115291fd51ae70"
      }
    }

  },
  "blockbook": {
    "package_name": "blockbook-syscoin-testnet",
    "system_user": "blockbook-syscoin",
    "internal_binding_template": ":{{.Ports.BlockbookInternal}}",
    "public_binding_template": ":{{.Ports.BlockbookPublic}}",
    "explorer_url": "",
    "additional_params": "-dbcache=4294967296 -dbmaxopenfiles=500000 -workers=16 -chunk=1000 -extendedindex",
    "block_chain": {
      "parse": true,
      "mempool_workers": 8,
      "mempool_sub_workers": 2,
      "block_addresses_to_keep": 300,
      "xpub_magic": 70617039,
      "xpub_magic_segwit_p2sh": 71979618,
      "xpub_magic_segwit_native": 73342198,
      "slip44": 1,
      "web3_rpc_url": "http://127.0.0.1:18545",
      "web3_rpc_url_backup": "",
      "web3_explorer_url": "https://explorer.tanenbaum.io",
      "subversion": "/Satoshi:5.1.3/",
      "additional_params": {
      }
    }
  },
  "meta": {
    "package_maintainer": "sidhujag",
    "package_maintainer_email": "sidhujag@syscoin.org"
  }
}
